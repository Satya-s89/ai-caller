# ──────────────────────────────────────────────────────────────
# Groq (FREE — https://console.groq.com)
# Model: llama-3.3-70b-versatile
# ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────────────────────
# Sarvam AI (FREE — https://dashboard.sarvam.ai)
# Used for both STT (saarika:v2.5) and TTS (bulbul:v2)
# ──────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# STT Provider: 'sarvam' (default, best Telugu) | 'groq' | 'local'
STT_PROVIDER=sarvam

# TTS Speaker (Sarvam bulbul:v2): meera | pavithra
SARVAM_TTS_SPEAKER=meera

# ──────────────────────────────────────────────────────────────
# LiveKit Cloud (FREE — https://cloud.livekit.io)
# ──────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ──────────────────────────────────────────────────────────────
# Twilio (Trial — https://twilio.com)
# ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15175512681

# ──────────────────────────────────────────────────────────────
# Optional tuning
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DASHBOARD_PORT=3000
# Edge TTS fallback voice (used when SARVAM_API_KEY is not set)
TTS_VOICE=te-IN-ShrutiNeural
# Suppress HuggingFace symlink warning on Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1
